# ============================================================
#  Copy to .env and fill in. Never commit .env.
# ============================================================

# --- Bunny -------------------------------------------------
# Pull Zone / Stream CDN hostname (no scheme, no trailing slash).
BUNNY_CDN_HOSTNAME=vz-26e92cee-791.b-cdn.net

# Token Authentication key. Stream: Library -> API -> "Token Authentication Key".
# Pull Zone: Security -> Token Authentication -> "URL Token Authentication Key".
BUNNY_TOKEN_KEY=

# Stream library id (used only to build embed/iframe URLs).
BUNNY_LIBRARY_ID=724698

# --- Token policy ------------------------------------------
# Requested TTLs are clamped to this many seconds. Hard ceiling is 12h (43200).
TOKEN_TTL_SECONDS=21600
TOKEN_MAX_TTL_SECONDS=43200

# Bind the token to the requesting client's IP. Strong, but breaks playback when
# you move between wifi and cellular mid-session. Off by default for mobile use.
TOKEN_BIND_IP=false

# Sign a directory token covering the whole video folder rather than one file,
# so HLS playlists + segments under the same path are all covered by one token.
TOKEN_DIRECTORY_SCOPE=true

# --- Referrer gating ---------------------------------------
# Comma-separated hostnames allowed to request tokens. Also embedded in the
# token as Bunny's `token_referer`, so the CDN enforces it too.
ALLOWED_REFERRERS=localhost:8000,127.0.0.1:8000
# Reject token requests that arrive with no Referer/Origin header at all.
REQUIRE_REFERRER=true

# --- App auth ----------------------------------------------
# Skip the sign-in gate entirely. Only honoured for loopback connections, so
# it cannot expose the library if you bind to 0.0.0.0 or tunnel in.
AUTH_DISABLED=false
# Anything reachable off your LAN needs a real gate; Referer headers are
# client-controlled and are not one. Generate a hash with:
#   python -m server.auth hash "your passphrase"
APP_PASSWORD_HASH=
# Random 32+ byte string used to sign the session cookie.
SESSION_SECRET=
SESSION_TTL_SECONDS=2592000
# Set true when served over HTTPS (required for cookie Secure flag).
SESSION_COOKIE_SECURE=false

# --- Catalog -----------------------------------------------
CATALOG_PATH=data/catalog.json
BUCKETS_CONFIG=config/buckets.yaml

# --- Semantic similarity (optional) ------------------------
# Powers POST /api/suggest-similar. Leave blank and that one endpoint returns
# 503; nothing else in the app depends on either service.

# Hugging Face access token (Settings -> Access Tokens). Read scope is enough.
HF_API_KEY=
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# The feature-extraction route, not the bare model URL — the model's default
# pipeline is sentence-similarity, which rejects a single string.
HF_API_BASE=https://api-inference.huggingface.co/pipeline/feature-extraction

# Pinecone. The index must be 384-dimensional to match MiniLM, and must
# already contain vectors — nothing here writes to it.
PINECONE_API_KEY=
PINECONE_INDEX=usme-prep-library
PINECONE_NAMESPACE=
# Optional. Blank means the index host is looked up once from the name.
PINECONE_HOST=
